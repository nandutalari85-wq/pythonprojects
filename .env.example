# ====================================================================
# Agricultural Crop Production Analysis System - Environment Configuration
# ====================================================================

# Application Secret Key (Change this in production)
SECRET_KEY=college-project-agricultural-analysis-secure-key-2026

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1

# Maximum file upload size in bytes (5MB default)
MAX_CONTENT_LENGTH=5242880

# --------------------------------------------------------------------
# Database Settings (MySQL via PyMySQL)
# --------------------------------------------------------------------
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crop_analysis_db

# Optional direct connection string (overrides the DB_* variables above if set)
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/crop_analysis_db?charset=utf8mb4

# Set to true if you want to use SQLite without running a MySQL service:
USE_SQLITE=false
